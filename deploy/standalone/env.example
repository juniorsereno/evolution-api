EVOLUTION_IMAGE=evolution-api:replace-with-full-commit-sha
POSTGRES_IMAGE=postgres:16-alpine@sha256:replace-with-verified-digest
REDIS_IMAGE=redis:7-alpine@sha256:replace-with-verified-digest
CHATWOOT_DOCKER_NETWORK=vartana-app_default
CHATWOOT_HOSTNAME=app.vartana.ia.br
POSTGRES_PASSWORD=replace-with-random-secret
REDIS_PASSWORD=replace-with-random-secret
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://evolution.vartana.ia.br
DISABLE_MANAGER=false
TELEMETRY_ENABLED=false
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=false
LOG_LEVEL=ERROR,WARN
LOG_BAILEYS=error
LANGUAGE=pt-BR
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:replace-with-random-secret@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=vartana_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:replace-with-random-secret@evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=vartana_evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
CHATWOOT_ENABLED=true
CHATWOOT_MESSAGE_READ=false
CHATWOOT_MESSAGE_DELETE=false
CHATWOOT_BOT_CONTACT=true
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=true
CHATWOOT_IMPORT_HISTORICAL_MESSAGES=true
CONFIG_SESSION_PHONE_CLIENT=Mac OS
CONFIG_SESSION_PHONE_NAME=Desktop
AUTHENTICATION_API_KEY=replace-with-random-secret
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
NATS_ENABLED=false
KAFKA_ENABLED=false
WEBSOCKET_ENABLED=false
S3_ENABLED=false
OPENAI_ENABLED=false
TYPEBOT_ENABLED=false
DIFY_ENABLED=false
FLOWISE_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
PROMETHEUS_METRICS=false
